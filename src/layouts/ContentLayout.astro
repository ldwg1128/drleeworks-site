---
import BaseLayout from './BaseLayout.astro';
import type { Lang } from '../i18n/ui';
const { lang, title, description, showDescription = true, compact = false } = Astro.props as {
  lang: Lang;
  title: string;
  description: string;
  showDescription?: boolean;
  compact?: boolean;
};
---
<BaseLayout {lang} title={`${title} | DrLeeWorks`} {description}>
  <header class:list={['page-head', { 'page-head-compact': compact }]}><div class="container"><h1>{title}</h1>{showDescription && <p class="lead">{description}</p>}</div></header>
  <div class:list={['container', 'prose', { 'prose-compact': compact }]}><slot /></div>
</BaseLayout>

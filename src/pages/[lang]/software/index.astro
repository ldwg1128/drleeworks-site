---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SidebarShell from '../../../components/SidebarShell.astro';
import { ui, type Lang } from '../../../i18n/ui';
import { localizedPath } from '../../../utils/routes';
export function getStaticPaths(){return (['ko','en'] as Lang[]).map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props as {lang:Lang};
const t=ui[lang];
const items=await getCollection('software');
---
<BaseLayout {lang} title={`${t.software} | DrLeeWorks`} description={t.softwareIntro}>
  <header class="page-head"><div class="container"><h1>{t.software}</h1><p class="lead">{t.softwareIntro}</p></div></header>
  <section class="section section-with-sidebar"><SidebarShell {lang}><div class="content-list">{items.map(item=><article class="card"><div class="meta">{t.version} {item.data.version}</div><h2><a href={localizedPath(lang,`/software/${item.data.slug}`)}>{item.data.name}</a></h2><p>{item.data.description[lang]}</p></article>)}</div></SidebarShell></section>
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { type Lang, ui } from '../../../i18n/ui';
import { categoryPath } from '../../../config/content';
import { formatDate, localizedPath } from '../../../utils/routes';
export async function getStaticPaths(){const posts=await getCollection('posts',({data})=>!data.draft);return posts.map(post=>({params:{lang:post.data.lang,slug:post.data.slug},props:{post}}));}
const {post}=Astro.props;
const lang=post.data.lang as Lang;
const t=ui[lang];
const {Content}=await render(post);
const all=await getCollection('posts',({data})=>!data.draft);
const translation=post.data.translationKey?all.find(p=>p.data.translationKey===post.data.translationKey&&p.data.lang!==lang):undefined;
const otherLang: Lang = lang === 'ko' ? 'en' : 'ko';
const alternateHref = translation ? localizedPath(translation.data.lang, '/blog/' + translation.data.slug) : localizedPath(otherLang, '/blog');
const filterPath = localizedPath(lang, categoryPath(lang, post.data.category));
---
<BaseLayout {lang} title={`${post.data.title} | DrLeeWorks`} description={post.data.summary} image={post.data.featuredImage?.src} {alternateHref}>
  <header class="page-head"><div class="container">
    <div class="meta"><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published,lang)}</time> · <a href={filterPath}>{post.data.category}</a> · {post.data.author}</div>
    <h1>{post.data.title}</h1><p class="lead">{post.data.summary}</p>
    {post.data.updated && <p class="meta">{t.updated}: <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated,lang)}</time></p>}
    <div class="post-tags" aria-label="Tags">{post.data.tags.map((tag: string) => <a class="tag" href={`${filterPath}?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>
    {translation?<a href={localizedPath(translation.data.lang,`/blog/${translation.data.slug}`)}>{translation.data.lang==='ko'?'한국어로 읽기':'Read in English'} →</a>:<p class="meta">{t.noTranslation}</p>}
  </div></header>
  <article class="container prose">
    {post.data.featuredImage && <figure class="featured-figure"><Image src={post.data.featuredImage} alt={post.data.title} /><figcaption>{post.data.title}</figcaption></figure>}
    <Content />
  </article>
</BaseLayout>

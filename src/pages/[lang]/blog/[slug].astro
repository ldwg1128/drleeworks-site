---
import {getCollection,render} from 'astro:content';import BaseLayout from '../../../layouts/BaseLayout.astro';import {type Lang,ui} from '../../../i18n/ui';import {formatDate,localizedPath} from '../../../utils/routes';
export async function getStaticPaths(){const posts=await getCollection('posts',({data})=>!data.draft);return posts.map(post=>({params:{lang:post.data.lang,slug:post.data.slug},props:{post}}));}const {post}=Astro.props;const lang=post.data.lang as Lang;const t=ui[lang];const {Content}=await render(post);const all=await getCollection('posts',({data})=>!data.draft);const translation=post.data.translationKey?all.find(p=>p.data.translationKey===post.data.translationKey&&p.data.lang!==lang):undefined;
const otherLang: Lang = lang === 'ko' ? 'en' : 'ko';
const alternateHref = translation ? localizedPath(translation.data.lang, '/blog/' + translation.data.slug) : localizedPath(otherLang, '/blog');
---
<BaseLayout {lang} title={`${post.data.title} | DrLeeWorks`} description={post.data.summary} {alternateHref}><header class="page-head"><div class="container"><div class="meta">{formatDate(post.data.published,lang)} · {post.data.category} · {post.data.author}</div><h1>{post.data.title}</h1><p class="lead">{post.data.summary}</p><div class="post-tags" aria-label="Tags">{post.data.tags.map((tag: string) => <span class="tag">#{tag}</span>)}</div>{translation?<a href={localizedPath(translation.data.lang,`/blog/${translation.data.slug}`)}>{translation.data.lang==='ko'?'한국어로 읽기':'Read in English'} →</a>:<p class="meta">{t.noTranslation}</p>}</div></header><article class="container prose"><Content /></article></BaseLayout>

---
import ContentLayout from '../../layouts/ContentLayout.astro'; import { ui, type Lang } from '../../i18n/ui';
export function getStaticPaths(){return (['ko','en'] as Lang[]).map(lang=>({params:{lang},props:{lang}}));} const {lang}=Astro.props as {lang:Lang}; const t=ui[lang];
---
<ContentLayout {lang} title={t.about} description={t.aboutText} showDescription={false} compact>
  <h2>{t.aboutHeading}</h2>
  <p>{t.aboutText}</p>
  {t.aboutParagraphs.map(paragraph => <p>{paragraph}</p>)}
</ContentLayout>

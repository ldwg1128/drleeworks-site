---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SidebarShell from '../../../components/SidebarShell.astro';
import BoardPage from '../../../components/BoardPage.astro';
import type { Lang } from '../../../i18n/ui';
import { BOARD_CATEGORIES } from '../../../config/content';
export function getStaticPaths(){return (['ko','en'] as Lang[]).map(lang=>({params:{lang},props:{lang}}));}
const {lang}=Astro.props as {lang:Lang};
const copy={ko:{title:'노트',intro:'지식, 기술 정보, 연구·개발 경험과 사이트 운영 정보를 정리합니다.',heading:'노트 게시물'},en:{title:'Notes',intro:'Notes on knowledge, technology, research, development, and site operation.',heading:'Notes'}} as const;
const page=copy[lang];
const category=BOARD_CATEGORIES.notes[lang];
const posts=(await getCollection('posts',({data})=>!data.draft&&data.lang===lang&&data.category===category)).sort((a,b)=>b.data.published.valueOf()-a.data.published.valueOf());
---
<BaseLayout {lang} title={`${page.title} | DrLeeWorks`} description={page.intro}>
  <header class="page-head"><div class="container"><h1>{page.title}</h1><p class="lead">{page.intro}</p></div></header>
  <section class="section section-with-sidebar"><SidebarShell {lang}><BoardPage {lang} {posts} heading={page.heading}/></SidebarShell></section>
</BaseLayout>

---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import StressStrainDemo from '../../../components/StressStrainDemo.astro';
import { type Lang, ui } from '../../../i18n/ui';
import { categoryPath } from '../../../config/content';
import { hasInteractiveMarkers, splitByInteractiveMarkers, getSharedMarkdownProcessor } from '../../../utils/interactive-markers';
import { formatDate, localizedPath } from '../../../utils/routes';

// Maps a `<!-- interactive:ID --> `marker in a plain Markdown post to the shared Astro
// component that should render at that spot. Add new demos here as they are built.
const INTERACTIVE_COMPONENTS = { 'tensile-test': StressStrainDemo } as const;

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({
    params: { lang: post.data.lang, section: categoryPath(post.data.lang, post.data.category).slice(1), slug: post.data.slug },
    props: { post }
  }));
}
const { post } = Astro.props;
const lang = post.data.lang as Lang;
const t = ui[lang];

const usesInteractiveMarkers = hasInteractiveMarkers(post.body);
type Block = { type: 'html'; html: string } | { type: 'component'; id: string };
let Content: Awaited<ReturnType<typeof render>>['Content'] | undefined;
let blocks: Block[] = [];
if (usesInteractiveMarkers) {
  const processor = await getSharedMarkdownProcessor();
  blocks = await Promise.all(splitByInteractiveMarkers(post.body).map(async (segment): Promise<Block> => {
    if (segment.type === 'marker') return { type: 'component', id: segment.id };
    const rendered = await processor.render(segment.text);
    return { type: 'html', html: rendered.code };
  }));
} else {
  ({ Content } = await render(post));
}

const all = await getCollection('posts', ({ data }) => !data.draft);
const translation = all.find(candidate => candidate.data.translationKey === post.data.translationKey && candidate.data.lang !== lang);
const sectionPath = localizedPath(lang, categoryPath(lang, post.data.category));
const translationHref = translation
  ? `${localizedPath(translation.data.lang, categoryPath(translation.data.lang, translation.data.category))}/${translation.data.slug}`
  : null;
---
<BaseLayout {lang} title={`${post.data.title} | DrLeeWorks`} description={post.data.summary} image={post.data.featuredImage?.src} alternateHref={translationHref}>
  <header class="page-head"><div class="container">
    <div class="meta"><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published,lang)}</time> · <a href={sectionPath}>{post.data.category}</a> · {post.data.author}</div>
    <h1>{post.data.title}</h1><p class="lead">{post.data.summary}</p>
    {post.data.updated && <p class="meta">{t.updated}: <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated,lang)}</time></p>}
    <div class="post-tags" aria-label="Tags">{post.data.tags.map((tag: string) => <a class="tag" href={`${sectionPath}?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>
    {translation && translationHref ? <a href={translationHref}>{translation.data.lang === 'ko' ? '한국어로 읽기' : 'Read in English'} →</a> : <p class="meta">{t.noTranslation}</p>}
  </div></header>
  <article class="container prose">
    {post.data.featuredImage && <figure class="featured-figure"><Image src={post.data.featuredImage} alt={post.data.title} /><figcaption>{post.data.title}</figcaption></figure>}
    <div class="markdown-body">
      {usesInteractiveMarkers ? blocks.map(block => {
        if (block.type === 'html') return <Fragment set:html={block.html} />;
        const Component = INTERACTIVE_COMPONENTS[block.id as keyof typeof INTERACTIVE_COMPONENTS];
        return Component ? <Component lang={lang} /> : null;
      }) : Content && <Content />}
    </div>
  </article>
</BaseLayout>

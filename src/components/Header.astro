---
import { languages, type Lang } from '../i18n/ui';
import { localizedPath, switchLanguagePath } from '../utils/routes';
import { getGlobalNavigation } from '../config/navigation';
interface Props { lang: Lang; alternateHref?: string | null; }
const { lang, alternateHref } = Astro.props;
const pathname = Astro.url.pathname;
const items = getGlobalNavigation(lang);
const isCurrent = (path: string) => path ? pathname.startsWith(`/${lang}${path}`) : pathname === `/${lang}` || pathname === `/${lang}/`;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localizedPath(lang)}>DrLeeWorks</a>
    <nav class="nav" aria-label="Primary navigation">
      {items.map(({path, label}) => <a href={localizedPath(lang, path)} aria-current={isCurrent(path) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="language" aria-label="Language">
      {(Object.entries(languages) as [Lang,string][]).map(([code, label]) => {
        if (code === lang) return <a class="active" href={pathname} hreflang={code} aria-current="page">{label}</a>;
        if (alternateHref === null) return <span class="unavailable" aria-disabled="true" title={code === 'ko' ? '한국어 번역이 없습니다.' : 'English translation is not available.'}>{label}</span>;
        return <a href={alternateHref ?? switchLanguagePath(pathname, code)} hreflang={code}>{label}</a>;
      })}
    </div>
  </div>
</header>

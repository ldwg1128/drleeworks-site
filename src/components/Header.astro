---
import { languages, type Lang } from '../i18n/ui';
import { localizedPath, switchLanguagePath } from '../utils/routes';
import { getGlobalNavigation } from '../config/navigation';
interface Props { lang: Lang; alternateHref?: string; }
const { lang, alternateHref } = Astro.props;
const pathname = Astro.url.pathname;
const items = getGlobalNavigation(lang);
const isCurrent = (path: string) => path ? pathname.startsWith(`/${lang}${path}`) : pathname === `/${lang}` || pathname === `/${lang}/`;
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={localizedPath(lang)}>DrLeeWorks</a>
    <nav class="nav" aria-label="Primary navigation">
      {items.map(({path, label}) => <a href={localizedPath(lang, path)} aria-current={isCurrent(path) ? 'page' : undefined}>{label}</a>)}
    </nav>
    <div class="language" aria-label="Language">
      {(Object.entries(languages) as [Lang,string][]).map(([code, label]) => <a class:list={{active:code===lang}} href={code === lang ? pathname : (alternateHref ?? switchLanguagePath(pathname, code))} hreflang={code}>{label}</a>)}
    </div>
  </div>
</header>

---
import type { Lang } from '../i18n/ui';

const { lang } = Astro.props as { lang: Lang };
const copy = {
  ko: {
    note: '번식, 유전, 작은 변이, 포식, 굶주림, 보호 구역만으로 population dynamics와 형질 변화를 관찰합니다.',
    preyReproduction: 'Prey Reproduction Interval', starvation: 'Predator Starvation Time', safeZone: 'Safe Zone', safeSize: 'Safe Zone Size',
    run: 'Run', pause: 'Pause', newWorld: 'New World', reset: 'Reset', seed: 'Seed', apply: 'Apply', prey: 'Prey', predators: 'Predators', time: 'Time',
    avgSpeed: 'Average Speed', avgWidth: 'Average Width', avgHeight: 'Average Height', initial: 'Initial', current: 'Current',
    preyExtinct: 'Prey extinct', predatorExtinct: 'Predator extinct', safety: 'Simulation paused: population exceeded the browser safety limit.'
  },
  en: {
    note: 'Observe population dynamics and trait change using only reproduction, inheritance, small mutation, predation, starvation, and a protected zone.',
    preyReproduction: 'Prey Reproduction Interval', starvation: 'Predator Starvation Time', safeZone: 'Safe Zone', safeSize: 'Safe Zone Size',
    run: 'Run', pause: 'Pause', newWorld: 'New World', reset: 'Reset', seed: 'Seed', apply: 'Apply', prey: 'Prey', predators: 'Predators', time: 'Time',
    avgSpeed: 'Average Speed', avgWidth: 'Average Width', avgHeight: 'Average Height', initial: 'Initial', current: 'Current',
    preyExtinct: 'Prey extinct', predatorExtinct: 'Predator extinct', safety: 'Simulation paused: population exceeded the browser safety limit.'
  }
} as const;
const t = copy[lang];
const defaults = { reproductionInterval: 8, starvationTime: 20, safeZone: true, safeZoneSize: 92 };
const defaultSeed = 731942;
---

<div class="pp-demo" data-pp-demo data-lang={lang} data-default-seed={defaultSeed}
  data-default-reproduction={defaults.reproductionInterval} data-default-starvation={defaults.starvationTime}
  data-default-safe-zone={defaults.safeZone} data-default-safe-size={defaults.safeZoneSize}>
  <p class="meta pp-note">{t.note}</p>
  <div class="pp-world"><canvas data-pp-canvas></canvas></div>
  <div class="pp-seed-row">
    <label><span>{t.seed}</span><input type="number" data-pp-seed min="0" max="4294967295" step="1" value={defaultSeed} /></label>
    <button type="button" class="button secondary" data-pp-apply>{t.apply}</button>
  </div>
  <div class="pp-controls">
    <label class="pp-field"><span>{t.preyReproduction}<output data-pp-value="reproductionInterval"></output></span><input type="range" data-pp-range="reproductionInterval" min="3" max="20" step="0.5" value={defaults.reproductionInterval} /></label>
    <label class="pp-field"><span>{t.starvation}<output data-pp-value="starvationTime"></output></span><input type="range" data-pp-range="starvationTime" min="5" max="60" step="1" value={defaults.starvationTime} /></label>
    <label class="pp-toggle"><input type="checkbox" data-pp-safe checked={defaults.safeZone} /><span>{t.safeZone}</span></label>
    <label class="pp-field" data-pp-size-field><span>{t.safeSize}<output data-pp-value="safeZoneSize"></output></span><input type="range" data-pp-range="safeZoneSize" min="45" max="170" step="1" value={defaults.safeZoneSize} /></label>
  </div>
  <div class="pp-actions"><button type="button" class="button" data-pp-run>{t.run}</button><button type="button" class="button secondary" data-pp-new>{t.newWorld}</button><button type="button" class="button secondary" data-pp-reset>{t.reset}</button></div>
  <div class="pp-stats" aria-live="polite"><span><b>{t.prey}</b><strong data-pp-stat="prey">40</strong></span><span><b>{t.predators}</b><strong data-pp-stat="predators">5</strong></span><span><b>{t.time}</b><strong data-pp-stat="time">00:00</strong></span></div>
  <div class="pp-chart"><canvas data-pp-chart></canvas></div>
  <div class="pp-traits"><h3>{t.avgSpeed}</h3><span>{t.initial} <strong data-pp-initial="speed">1.20</strong></span><span>{t.current} <strong data-pp-current="speed">1.20</strong></span><h3>{t.avgWidth}</h3><span>{t.initial} <strong data-pp-initial="width">3.00</strong></span><span>{t.current} <strong data-pp-current="width">3.00</strong></span><h3>{t.avgHeight}</h3><span>{t.initial} <strong data-pp-initial="height">3.00</strong></span><span>{t.current} <strong data-pp-current="height">3.00</strong></span></div>
  <p class="pp-status meta" data-pp-status></p>
</div>

<script>
  type Params = { reproductionInterval: number; starvationTime: number; safeZone: boolean; safeZoneSize: number };
  type Prey = { x: number; y: number; vx: number; vy: number; width: number; height: number; speed: number; reproductionTimer: number };
  type Predator = { x: number; y: number; vx: number; vy: number; eaten: number; sinceMeal: number };
  type Point = { x: number; y: number };
  type NumericParam = Exclude<keyof Params, 'safeZone'>;
  const CONFIG = { initialPrey: 40, initialPredators: 5, preySpeed: 1.2, preySize: 3, predatorSpeed: 1.05, predatorSize: 7, mutation: 0.4, safetyLimit: 400, historyLimit: 240, historyInterval: 0.25, fixedStep: 1 / 60 };

  class SeededRandom {
    private state: number;
    constructor(seed: number) { this.state = seed >>> 0 || 1; }
    next() { this.state = (1664525 * this.state + 1013904223) >>> 0; return this.state / 4294967296; }
    signed() { return this.next() * 2 - 1; }
  }
  const clamp = (value: number, min: number, max: number) => Math.min(max, Math.max(min, value));
  const distance = (a: Point, b: Point) => Math.hypot(a.x - b.x, a.y - b.y);
  const clock = (seconds: number) => `${String(Math.floor(seconds / 60)).padStart(2, '0')}:${String(Math.floor(seconds % 60)).padStart(2, '0')}`;

  document.querySelectorAll<HTMLElement>('[data-pp-demo]').forEach(root => {
    const canvas = root.querySelector<HTMLCanvasElement>('[data-pp-canvas]');
    const chart = root.querySelector<HTMLCanvasElement>('[data-pp-chart]');
    const context = canvas?.getContext('2d');
    const chartContext = chart?.getContext('2d');
    if (!canvas || !chart || !context || !chartContext) return;
    const drawingCanvas = canvas; const drawingContext = context; const historyCanvas = chart; const historyContext = chartContext;
    const defaults: Params = { reproductionInterval: Number(root.dataset.defaultReproduction), starvationTime: Number(root.dataset.defaultStarvation), safeZone: root.dataset.defaultSafeZone === 'true', safeZoneSize: Number(root.dataset.defaultSafeSize) };
    let params = { ...defaults }; let seed = Number(root.dataset.defaultSeed) >>> 0; let rng = new SeededRandom(seed);
    let prey: Prey[] = []; let predators: Predator[] = []; let width = 0; let height = 0; let elapsed = 0; let accumulator = 0; let sampleTimer = 0; let running = false; let lastTime = performance.now(); let history: { time: number; prey: number; predators: number }[] = []; let initialTraits = { speed: CONFIG.preySpeed, width: CONFIG.preySize, height: CONFIG.preySize };
    const rangeInputs = [...root.querySelectorAll<HTMLInputElement>('[data-pp-range]')]; const valueOutputs = [...root.querySelectorAll<HTMLOutputElement>('[data-pp-value]')]; const stat = (name: string) => root.querySelector<HTMLElement>(`[data-pp-stat="${name}"]`)!;
    const traitAverage = (trait: keyof Pick<Prey, 'speed' | 'width' | 'height'>) => prey.length ? prey.reduce((sum, item) => sum + item[trait], 0) / prey.length : 0;
    const traitText = (value: number) => value.toFixed(2);
    function resize() { const dpr = window.devicePixelRatio || 1; width = drawingCanvas.clientWidth; height = drawingCanvas.clientHeight; drawingCanvas.width = Math.max(1, Math.floor(width * dpr)); drawingCanvas.height = Math.max(1, Math.floor(height * dpr)); drawingContext.setTransform(dpr, 0, 0, dpr, 0, 0); const chartDpr = window.devicePixelRatio || 1; historyCanvas.width = Math.max(1, Math.floor(historyCanvas.clientWidth * chartDpr)); historyCanvas.height = Math.max(1, Math.floor(historyCanvas.clientHeight * chartDpr)); historyContext.setTransform(chartDpr, 0, 0, chartDpr, 0, 0); }
    function makePrey(x = PARTICLE_X(), y = PARTICLE_Y(), speed = CONFIG.preySpeed, itemWidth = CONFIG.preySize, itemHeight = CONFIG.preySize): Prey { const angle = rng.next() * Math.PI * 2; return { x, y, vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed, speed, width: itemWidth, height: itemHeight, reproductionTimer: params.reproductionInterval * (0.85 + rng.next() * 0.3) }; }
    function PARTICLE_X() { return 8 + rng.next() * Math.max(1, width - 16); }
    function PARTICLE_Y() { return 8 + rng.next() * Math.max(1, height - 16); }
    function randomDirection(speed: number) { const angle = rng.next() * Math.PI * 2; return { vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed }; }
    function makePredator(): Predator { let x = PARTICLE_X(); let y = PARTICLE_Y(); let attempts = 0; while (params.safeZone && inSafeZone({ x, y }) && attempts++ < 20) { x = PARTICLE_X(); y = PARTICLE_Y(); } const direction = randomDirection(CONFIG.predatorSpeed); return { x, y, ...direction, eaten: 0, sinceMeal: 0 }; }
    function makeWorld() { rng = new SeededRandom(seed); elapsed = 0; accumulator = 0; sampleTimer = 0; history = []; prey = Array.from({ length: CONFIG.initialPrey }, () => makePrey()); predators = Array.from({ length: CONFIG.initialPredators }, () => makePredator()); initialTraits = { speed: traitAverage('speed'), width: traitAverage('width'), height: traitAverage('height') }; sampleHistory(); updateDisplay(); draw(); }
    function safeCenter() { return { x: width / 2, y: height / 2 }; }
    function inSafeZone(item: Point) { return params.safeZone && distance(item, safeCenter()) < params.safeZoneSize; }
    function mutate(value: number, minimum: number, maximum: number) { return clamp(value * (1 + rng.signed() * CONFIG.mutation), minimum, maximum); }
    function dividePrey(index: number) { const parent = prey[index]; const children = [makePrey(parent.x, parent.y, mutate(parent.speed, 0.35, 2.8), mutate(parent.width, 1.4, 7), mutate(parent.height, 1.4, 7)), makePrey(parent.x, parent.y, mutate(parent.speed, 0.35, 2.8), mutate(parent.width, 1.4, 7), mutate(parent.height, 1.4, 7))]; prey.splice(index, 1, ...children); }
    function dividePredator(index: number) { const parent = predators[index]; const firstDirection = randomDirection(CONFIG.predatorSpeed); const secondDirection = randomDirection(CONFIG.predatorSpeed); predators.splice(index, 1, { x: parent.x, y: parent.y, ...firstDirection, eaten: 0, sinceMeal: 0 }, { x: parent.x + 2, y: parent.y + 2, ...secondDirection, eaten: 0, sinceMeal: 0 }); }
    function step() {
      for (let index = prey.length - 1; index >= 0; index--) { const item = prey[index]; const turn = rng.signed() * 0.16; const cos = Math.cos(turn); const sin = Math.sin(turn); const nextVx = item.vx * cos - item.vy * sin; const nextVy = item.vx * sin + item.vy * cos; item.vx = (nextVx / Math.max(Math.hypot(nextVx, nextVy), 0.001)) * item.speed; item.vy = (nextVy / Math.max(Math.hypot(nextVx, nextVy), 0.001)) * item.speed; item.x = clamp(item.x + item.vx, item.width, width - item.width); item.y = clamp(item.y + item.vy, item.height, height - item.height); if (item.x === item.width || item.x === width - item.width) item.vx *= -1; if (item.y === item.height || item.y === height - item.height) item.vy *= -1; item.reproductionTimer -= CONFIG.fixedStep; if (item.reproductionTimer <= 0 && prey.length + predators.length < CONFIG.safetyLimit) dividePrey(index); }
      for (let predatorIndex = predators.length - 1; predatorIndex >= 0; predatorIndex--) { const predator = predators[predatorIndex]; predator.x += predator.vx; predator.y += predator.vy; let hitWall = false; if (predator.x <= CONFIG.predatorSize || predator.x >= width - CONFIG.predatorSize) { predator.x = clamp(predator.x, CONFIG.predatorSize, width - CONFIG.predatorSize); hitWall = true; } if (predator.y <= CONFIG.predatorSize || predator.y >= height - CONFIG.predatorSize) { predator.y = clamp(predator.y, CONFIG.predatorSize, height - CONFIG.predatorSize); hitWall = true; } if (hitWall) { const direction = randomDirection(CONFIG.predatorSpeed); predator.vx = direction.vx; predator.vy = direction.vy; } if (params.safeZone) { const center = safeCenter(); const gap = distance(predator, center); const minimum = params.safeZoneSize + CONFIG.predatorSize; if (gap < minimum) { const angle = gap > 0.001 ? Math.atan2(predator.y - center.y, predator.x - center.x) : rng.next() * Math.PI * 2; predator.x = clamp(center.x + Math.cos(angle) * minimum, CONFIG.predatorSize, width - CONFIG.predatorSize); predator.y = clamp(center.y + Math.sin(angle) * minimum, CONFIG.predatorSize, height - CONFIG.predatorSize); const direction = randomDirection(CONFIG.predatorSpeed); predator.vx = direction.vx; predator.vy = direction.vy; } } predator.sinceMeal += CONFIG.fixedStep; for (let preyIndex = prey.length - 1; preyIndex >= 0; preyIndex--) { if (!inSafeZone(prey[preyIndex]) && distance(predator, prey[preyIndex]) < CONFIG.predatorSize + Math.max(prey[preyIndex].width, prey[preyIndex].height)) { prey.splice(preyIndex, 1); predator.eaten++; predator.sinceMeal = 0; if (predator.eaten >= 10 && predators.length + prey.length < CONFIG.safetyLimit) { dividePredator(predatorIndex); break; } } } if (predator.sinceMeal >= params.starvationTime) predators.splice(predatorIndex, 1); }
      elapsed += CONFIG.fixedStep; sampleTimer += CONFIG.fixedStep; if (sampleTimer >= CONFIG.historyInterval) { sampleTimer -= CONFIG.historyInterval; sampleHistory(); }
    }
    function sampleHistory() { history.push({ time: elapsed, prey: prey.length, predators: predators.length }); if (history.length > CONFIG.historyLimit) history.shift(); }
    function updateDisplay() { stat('prey').textContent = String(prey.length); stat('predators').textContent = String(predators.length); stat('time').textContent = clock(elapsed); (['speed', 'width', 'height'] as const).forEach(trait => { root.querySelector(`[data-pp-initial="${trait}"]`)!.textContent = traitText(initialTraits[trait]); root.querySelector(`[data-pp-current="${trait}"]`)!.textContent = traitText(traitAverage(trait)); }); const status = root.querySelector<HTMLElement>('[data-pp-status]')!; const messages: string[] = []; if (!prey.length) messages.push('Prey extinct'); if (!predators.length) messages.push('Predator extinct'); if (prey.length + predators.length >= CONFIG.safetyLimit) messages.push('Simulation paused: population exceeded the browser safety limit.'); status.textContent = messages.join(' · '); }
    function drawChart() { const chartWidth = historyCanvas.clientWidth; const chartHeight = historyCanvas.clientHeight; const style = getComputedStyle(document.documentElement); const line = style.getPropertyValue('--line').trim() || '#dbe1e5'; const green = '#3e8f62'; const red = '#b34b4b'; historyContext.clearRect(0, 0, chartWidth, chartHeight); historyContext.strokeStyle = line; historyContext.strokeRect(0.5, 0.5, chartWidth - 1, chartHeight - 1); const max = Math.max(10, ...history.map(point => Math.max(point.prey, point.predators))); const drawLine = (key: 'prey' | 'predators', color: string) => { historyContext.strokeStyle = color; historyContext.lineWidth = 1.8; historyContext.beginPath(); history.forEach((point, index) => { const x = history.length < 2 ? 0 : index / (history.length - 1) * chartWidth; const y = chartHeight - point[key] / max * (chartHeight - 8) - 4; if (!index) historyContext.moveTo(x, y); else historyContext.lineTo(x, y); }); historyContext.stroke(); }; drawLine('prey', green); drawLine('predators', red); }
    function draw() { const style = getComputedStyle(document.documentElement); const wash = style.getPropertyValue('--wash').trim() || '#f5f7f8'; const line = style.getPropertyValue('--line').trim() || '#dbe1e5'; drawingContext.clearRect(0, 0, width, height); if (params.safeZone) { drawingContext.fillStyle = wash; drawingContext.beginPath(); drawingContext.arc(width / 2, height / 2, params.safeZoneSize, 0, Math.PI * 2); drawingContext.fill(); drawingContext.strokeStyle = line; drawingContext.stroke(); } drawingContext.fillStyle = '#3e8f62'; prey.forEach(item => { drawingContext.beginPath(); drawingContext.ellipse(item.x, item.y, item.width, item.height, 0, 0, Math.PI * 2); drawingContext.fill(); }); drawingContext.fillStyle = '#b34b4b'; predators.forEach(item => { drawingContext.beginPath(); drawingContext.arc(item.x, item.y, CONFIG.predatorSize, 0, Math.PI * 2); drawingContext.fill(); }); drawChart(); }
    function syncControls() { rangeInputs.forEach(input => { const key = input.dataset.ppRange as NumericParam; input.value = String(params[key]); }); valueOutputs.forEach(output => { const key = output.dataset.ppValue as NumericParam; const value = params[key]; output.textContent = `${value.toFixed(key === 'safeZoneSize' ? 0 : 1)}${key === 'safeZoneSize' ? ' px' : ' s'}`; }); root.querySelector<HTMLInputElement>('[data-pp-safe]')!.checked = params.safeZone; root.querySelector<HTMLElement>('[data-pp-size-field]')!.hidden = !params.safeZone; }
    function animate(time: number) { const delta = Math.min((time - lastTime) / 1000, 0.1); lastTime = time; if (running) { accumulator += delta; while (accumulator >= CONFIG.fixedStep) { step(); accumulator -= CONFIG.fixedStep; } updateDisplay(); draw(); } requestAnimationFrame(animate); }
    rangeInputs.forEach(input => input.addEventListener('input', () => { params[input.dataset.ppRange as NumericParam] = Number(input.value); syncControls(); draw(); })); root.querySelector<HTMLInputElement>('[data-pp-safe]')!.addEventListener('change', event => { params.safeZone = (event.target as HTMLInputElement).checked; syncControls(); draw(); });
    root.querySelector('[data-pp-run]')?.addEventListener('click', () => { running = !running; root.querySelector<HTMLButtonElement>('[data-pp-run]')!.textContent = running ? 'Pause' : 'Run'; lastTime = performance.now(); }); root.querySelector('[data-pp-new]')?.addEventListener('click', () => { seed = (window.crypto?.getRandomValues(new Uint32Array(1))[0] || Date.now()) >>> 0; root.querySelector<HTMLInputElement>('[data-pp-seed]')!.value = String(seed); makeWorld(); }); root.querySelector('[data-pp-apply]')?.addEventListener('click', () => { seed = Number(root.querySelector<HTMLInputElement>('[data-pp-seed]')!.value) >>> 0; makeWorld(); }); root.querySelector('[data-pp-reset]')?.addEventListener('click', () => { params = { ...defaults }; seed = Number(root.dataset.defaultSeed) >>> 0; root.querySelector<HTMLInputElement>('[data-pp-seed]')!.value = String(seed); syncControls(); makeWorld(); });
    new ResizeObserver(() => { resize(); draw(); }).observe(drawingCanvas); resize(); syncControls(); makeWorld(); requestAnimationFrame(animate);
  });
</script>

<style>
  .pp-demo{border:1px solid var(--line);border-radius:4px;background:var(--paper);padding:1.25rem;margin:1.75rem 0}.pp-note{margin:0 0 1rem}.pp-world{border:1px solid var(--line);background:var(--wash);border-radius:3px;overflow:hidden}.pp-world canvas{display:block;width:100%;height:380px}.pp-seed-row{display:flex;align-items:end;gap:.6rem;margin-top:.85rem}.pp-seed-row label{display:flex;flex-direction:column;gap:.25rem;color:var(--muted);font-size:.82rem}.pp-seed-row input{width:10rem;border:1px solid var(--line);border-radius:3px;padding:.35rem .45rem;background:var(--paper);color:var(--ink);font:inherit}.pp-controls{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.9rem 1.5rem;margin-top:1.2rem}.pp-field{display:flex;flex-direction:column;gap:.3rem;color:var(--ink);font-size:.9rem}.pp-field span{display:flex;justify-content:space-between;gap:1rem;font-weight:600}.pp-field output{color:var(--muted);font-weight:400}.pp-field input{width:100%;accent-color:var(--accent)}.pp-toggle{display:flex;align-items:center;gap:.5rem;align-self:end;min-height:2rem;color:var(--ink);font-size:.9rem}.pp-toggle input{accent-color:var(--accent)}.pp-actions{display:flex;flex-wrap:wrap;gap:.5rem;margin-top:1.1rem}.pp-actions .button{font-size:.9rem}.pp-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.5rem;border-top:1px solid var(--line);margin-top:1.2rem;padding-top:1rem}.pp-stats span{display:flex;flex-direction:column;gap:.15rem}.pp-stats b,.pp-traits span{color:var(--muted);font-size:.8rem}.pp-stats strong{font-size:1.1rem;font-variant-numeric:tabular-nums}.pp-chart{margin-top:1rem}.pp-chart canvas{display:block;width:100%;height:130px}.pp-traits{display:grid;grid-template-columns:1.3fr 1fr 1fr;gap:.4rem 1rem;border-top:1px solid var(--line);margin-top:1rem;padding-top:1rem}.pp-traits h3{margin:0;color:var(--ink);font-size:.9rem}.pp-traits span{font-variant-numeric:tabular-nums}.pp-traits strong{color:var(--ink);font-weight:650}.pp-status{min-height:1.5em;margin:.8rem 0 0;color:#a33f3f}
  @media(max-width:760px){.pp-demo{padding:1rem}.pp-world canvas{height:270px}.pp-controls{grid-template-columns:1fr}.pp-stats{grid-template-columns:repeat(3,1fr)}.pp-traits{grid-template-columns:1fr 1fr}.pp-traits h3{grid-column:1/-1;margin-top:.35rem}.pp-seed-row{align-items:stretch;flex-wrap:wrap}.pp-seed-row label{flex:1;min-width:9rem}}
</style>
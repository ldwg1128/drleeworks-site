---
interface Props { id: string; title: string; }
const { id, title } = Astro.props;
if (!/^[A-Za-z0-9_-]{6,20}$/.test(id)) throw new Error(`Invalid YouTube video id: ${id}`);
---
<div class="youtube-embed">
  <iframe src={`https://www.youtube-nocookie.com/embed/${id}`} title={title} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
</div>

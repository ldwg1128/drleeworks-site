---
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../i18n/ui';
import { formatDate, localizedPath } from '../utils/routes';
const { post, lang } = Astro.props as { post: CollectionEntry<'posts'>, lang: Lang };
---
<article class="card">
  <div class="meta">{formatDate(post.data.published, lang)} · {post.data.category}</div>
  <h3><a href={localizedPath(lang, `/blog/${post.data.slug}`)}>{post.data.title}</a></h3>
  <p>{post.data.summary}</p>
  <div>{post.data.tags.map(tag => <span class="tag">#{tag}</span>)}</div>
</article>

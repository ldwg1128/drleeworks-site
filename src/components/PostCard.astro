---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import type { Lang } from '../i18n/ui';
import { formatDate, localizedPath } from '../utils/routes';
import { categoryPath } from '../config/content';
const { post, lang } = Astro.props as { post: CollectionEntry<'posts'>, lang: Lang };
const sectionPath = localizedPath(lang, categoryPath(lang, post.data.category));
const articlePath = `${sectionPath}/${post.data.slug}`;
---
<article class="card post-card">
  {post.data.featuredImage && <a class="post-card-image" href={articlePath} aria-label={post.data.title}><Image src={post.data.featuredImage} alt="" /></a>}
  <div class="meta">{formatDate(post.data.published, lang)} · <a href={sectionPath}>{post.data.category}</a></div>
  <h3><a href={articlePath}>{post.data.title}</a></h3>
  <p>{post.data.summary}</p>
  <div class="post-tags" aria-label="Tags">{post.data.tags.map(tag => <a class="tag" href={`${sectionPath}?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>
</article>

---
import type { Lang } from '../i18n/ui';
import StressStrainDemo from './StressStrainDemo.astro';

const { markers, lang } = Astro.props as { markers: string[]; lang: Lang };

// Add future marker/component mappings here. Markdown files and the post route
// do not need to change when a new reusable interactive block is registered.
const registry: Partial<Record<string, typeof StressStrainDemo>> = {
  'tensile-test': StressStrainDemo
};

const blocks = markers.flatMap((id, markerIndex) => {
  const Component = registry[id];
  return Component ? [{ id, markerIndex, Component }] : [];
});
---

{blocks.map(({ id, markerIndex, Component }) => (
  <div data-interactive-source={id} data-interactive-index={markerIndex} hidden>
    <Component {lang} mode="compact" />
  </div>
))}

<script is:inline>
  (() => {
    const markers = [...document.querySelectorAll('[data-interactive-marker]')];
    document.querySelectorAll('[data-interactive-source]').forEach(source => {
      const id = source.getAttribute('data-interactive-source');
      const target = markers.find(marker =>
        !marker.hasAttribute('data-interactive-filled') &&
        marker.getAttribute('data-interactive-marker') === id
      );
      if (!target) return;
      target.setAttribute('data-interactive-filled', '');
      source.removeAttribute('hidden');
      source.removeAttribute('data-interactive-source');
      source.removeAttribute('data-interactive-index');
      target.replaceWith(source);
    });
  })();
</script>
